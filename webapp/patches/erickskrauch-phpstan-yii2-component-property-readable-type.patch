Make ComponentPropertyReflection report the resolved component type.

PHPStan 2 asks a property reflection for getReadableType()/getWritableType();
getType() is never called. ComponentPropertyReflection delegates both to the
fallback DummyPropertyReflection, which always answers `mixed`, so every
`Yii::$app-><component>` access degrades to `mixed` instead of the class
resolved from the application configuration.

Upstream: https://github.com/erickskrauch/phpstan-yii2

--- a/src/Reflection/ComponentPropertyReflection.php
+++ b/src/Reflection/ComponentPropertyReflection.php
@@ -20,7 +20,6 @@ final class ComponentPropertyReflection implements PropertyReflection {
         $this->type = $type;
     }
 
-    // TODO: seems to be unused
     public function getType(): Type {
         return $this->type;
     }
@@ -49,11 +48,11 @@ final class ComponentPropertyReflection implements PropertyReflection {
     }
 
     public function getReadableType(): Type {
-        return $this->fallbackProperty->getReadableType();
+        return $this->type;
     }
 
     public function getWritableType(): Type {
-        return $this->fallbackProperty->getWritableType();
+        return $this->type;
     }
 
     public function canChangeTypeAfterAssignment(): bool {
